APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg2://scholaris:change-me@localhost:5432/scholaris
# Required when APP_ENV=production; optional local shared rate limiting.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=generate-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:5500"]
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=scholaris@example.com
SMTP_USE_SSL=false
DEADLINE_EMAIL_HOUR_UTC=8
DEADLINE_EMAIL_MINUTE_UTC=0